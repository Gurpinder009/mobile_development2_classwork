<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AndroidFinalProject" parent="Theme.Material3.Dark.NoActionBar">
         <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/black</item>
        <item name="colorSecondary">@color/black</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>

        <item name="colorOnPrimary">@color/text_color_dark</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>



    <style name="MyToolbarNavigation" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="colorControlNormal">@color/black</item>
        <item name="titleTextColor">@color/black</item>

    </style>

    <style name="MyPopupTheme" parent="Theme.Material3.Dark.Dialog">
        <!-- Define your popup theme attributes here -->
    </style>


    <style name="MyBottomNavigation" parent="ThemeOverlay.Material3.BottomAppBar">
        <item name="colorSurface">@color/primary_dark</item>
<!--        <item name="itemActiveIndicatorColor"-->
    </style>


</resources>