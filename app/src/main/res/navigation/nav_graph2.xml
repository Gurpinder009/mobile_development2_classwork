<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph2"
    app:startDestination="@id/getStartedFragment">

    <fragment
        android:id="@+id/loginInFragment2"
        android:name="mobile.dev.androidfinalproject.fragments.userFragments.LoginInFragment"
        android:label="fragment_login_in"
        tools:layout="@layout/fragment_login_in" >
        <action
            android:id="@+id/action_loginInFragment2_to_signUpFragment2"
            app:destination="@id/signUpFragment2"
            app:popUpTo="@id/loginInFragment2"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment2"
        android:name="mobile.dev.androidfinalproject.fragments.userFragments.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up" >
        <action
            android:id="@+id/action_signUpFragment2_to_loginInFragment2"
            app:destination="@id/loginInFragment2"
            app:popUpTo="@id/signUpFragment2"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signUpFragment2_to_getDetailsFragment"
            app:destination="@id/getDetailsFragment"
            app:popUpTo="@id/getDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/getStartedFragment"
        android:name="mobile.dev.androidfinalproject.fragments.GetStartedFragment"
        android:label="fragment_get_started"
        tools:layout="@layout/fragment_get_started" >
        <action
            android:id="@+id/action_getStartedFragment_to_signUpFragment2"
            app:destination="@id/signUpFragment2" />
        <action
            android:id="@+id/action_getStartedFragment_to_loginInFragment2"
            app:destination="@id/loginInFragment2" />
    </fragment>
    <fragment
        android:id="@+id/getDetailsFragment"
        android:name="mobile.dev.androidfinalproject.fragments.GetDetailsFragment"
        android:label="fragment_get_details"
        tools:layout="@layout/fragment_get_details" >
        <argument
            android:name="userDetails"
            app:argType="mobile.dev.androidfinalproject.models.UserModel"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
</navigation>