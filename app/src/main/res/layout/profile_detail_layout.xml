<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"

    android:layout_marginHorizontal="16dp"
    android:elevation="0dp"

    android:layout_gravity="center_vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="20dp"
        android:paddingHorizontal="@dimen/profile_page_between_layout_padding">

        <TextView
            android:id="@+id/profilePageLabelTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/profile_page_between_txt_view_margin"
            android:layout_weight="1"
            android:text="@string/profile_page_detail_label"
            android:textSize="@dimen/profile_page_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profilePageValueTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_page_detail_value"
            android:textSize="@dimen/profile_page_text_size" />
    </LinearLayout>

</androidx.cardview.widget.CardView>

