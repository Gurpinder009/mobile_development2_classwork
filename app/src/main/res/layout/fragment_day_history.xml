<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.DayHistoryFragment">



        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:layout_marginTop="16dp">




            <LinearLayout
                android:paddingTop="75dp"
                android:paddingBottom="20dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="3dp"
                    app:contentPadding="16dp"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/totalProgress"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.2"
                                android:text="Your Progress"
                                android:textSize="24sp" />


                            <ProgressBar
                                android:id="@+id/totalProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="141dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.2"
                                android:max="100"
                                android:progress="15" />


                        </LinearLayout>

                        <TextView
                            android:id="@+id/totalProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_weight="0.4"
                            android:text="95%"
                            android:textSize="36sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />



                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.cardview.widget.CardView>


                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <TextView
                    android:text="your activities"
                    android:textSize="28sp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />
                <LinearLayout

                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">





                    <androidx.cardview.widget.CardView

                        android:layout_height="wrap_content"
                        android:layout_marginVertical="5dp"
                        app:cardElevation="2dp"
                        app:contentPadding="10dp"
                        app:cardCornerRadius="5dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_width="match_parent"


                        >
                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_weight="1"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="26dp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Calories"/>
                                <TextView
                                    android:id="@+id/caloriesConsumed"
                                    android:textSize="@dimen/dashboard_card_small_text"
                                    android:layout_weight="1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="57%"/>


                            </LinearLayout>





                            <TextView
                                android:id="@+id/caloriesPercentage"
                                android:textSize="24dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="57%"/>






                        </LinearLayout>
                    </androidx.cardview.widget.CardView>


                    <androidx.cardview.widget.CardView

                        android:layout_height="wrap_content"
                        android:layout_marginVertical="5dp"
                        app:cardElevation="2dp"
                        app:contentPadding="10dp"
                        app:cardCornerRadius="5dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_width="match_parent"


                        >
                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"

                            android:layout_height="match_parent">

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/dashboard_card_heading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sleep"/>
                                <TextView
                                    android:id="@+id/sleepDuration"
                                    android:textSize="@dimen/dashboard_card_small_text"
                                    android:layout_weight="1"

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="57%"/>

                            </LinearLayout>





                            <TextView
                                android:textSize="24dp"
                                android:id="@+id/sleepPercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="57%"/>






                        </LinearLayout>
                    </androidx.cardview.widget.CardView>



                    <androidx.cardview.widget.CardView

                        android:layout_height="wrap_content"
                        android:layout_marginVertical="5dp"
                        app:cardElevation="2dp"
                        app:contentPadding="10dp"
                        app:cardCornerRadius="5dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_width="match_parent"


                        >
                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/dashboard_card_heading"

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Water"/>
                                <TextView
                                    android:textSize="@dimen/dashboard_card_small_text"
                                    android:layout_weight="1"
                                    android:id="@+id/waterIntake"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="57%"/>

                            </LinearLayout>





                            <TextView
                                android:textSize="24dp"
                                android:id="@+id/waterPercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="57%"/>





                        </LinearLayout>
                    </androidx.cardview.widget.CardView>




                    <androidx.cardview.widget.CardView

                        android:layout_height="wrap_content"
                        android:layout_marginVertical="5dp"
                        app:cardElevation="2dp"
                        app:contentPadding="10dp"
                        app:cardCornerRadius="5dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_width="match_parent"


                        >
                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="@dimen/dashboard_card_heading"

                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Exercise Time"/>
                                <TextView
                                    android:textSize="@dimen/dashboard_card_small_text"

                                    android:id="@+id/exerciseTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="57%"/>


                            </LinearLayout>

                            <TextView
                                android:textSize="24dp"
                                android:id="@+id/exerciseTimePercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="57%"/>









                        </LinearLayout>
                    </androidx.cardview.widget.CardView>






                    <androidx.cardview.widget.CardView
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="5dp"
                        app:cardElevation="2dp"
                        app:contentPadding="16dp"
                        android:layout_marginHorizontal="16dp"
                        app:cardCornerRadius="5dp"
                        android:layout_width="match_parent"


                        >
                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_weight="1"

                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="BMI"
                                    android:textSize="@dimen/dashboard_card_heading" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/healthy_range_21_0_to_26_5"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <TextView
                                android:textSize="24dp"
                                android:id="@+id/bmiValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="26.0"/>


                        </LinearLayout>

                    </androidx.cardview.widget.CardView>







                </LinearLayout>




            </LinearLayout>

        </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

